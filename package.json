{
  "name": "uacs-vs-solution-explorer",
  "displayName": "UACS VS Solution Explorer",
  "description": "A lightweight Visual Studio-style explorer for .sln, .vcxproj and .vcxproj.filters.",
  "version": "0.1.0",
  "publisher": "uacs-local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "workspaceContains:**/*.sln"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uacs-vs-solution-explorer",
          "title": "VS解决方案",
          "icon": "$(symbol-folder)"
        }
      ]
    },
    "views": {
      "uacs-vs-solution-explorer": [
        {
          "id": "uacs-solution-tree",
          "name": "解决方案资源管理器",
          "contextualTitle": "UACS VS Solution Explorer"
        }
      ]
    },
    "commands": [
      { "command": "uacsSolutionExplorer.openSolution", "title": "UACS: 打开解决方案" },
      { "command": "uacsSolutionExplorer.refresh", "title": "UACS: 刷新解决方案树" },
      { "command": "uacsSolutionExplorer.selectSolution", "title": "UACS: 选择解决方案文件" },
      { "command": "uacsSolutionExplorer.createFile", "title": "UACS: 新建代码文件" },
      { "command": "uacsSolutionExplorer.addExistingFile", "title": "导入现有代码文件..." },
      { "command": "uacsSolutionExplorer.newFile", "title": "新建文件..." },
      { "command": "uacsSolutionExplorer.newFolder", "title": "新建文件夹..." },
      { "command": "uacsSolutionExplorer.revealInFinder", "title": "Reveal in Finder" },
      { "command": "uacsSolutionExplorer.openInTerminal", "title": "在集成终端中打开" },
      { "command": "uacsSolutionExplorer.addDirectoryToChat", "title": "Add Directory to Cursor Chat" },
      { "command": "uacsSolutionExplorer.addDirectoryToNewChat", "title": "Add Directory to New Cursor Chat" },
      { "command": "uacsSolutionExplorer.findInFolder", "title": "在文件夹中查找..." },
      { "command": "uacsSolutionExplorer.cut", "title": "剪切" },
      { "command": "uacsSolutionExplorer.copy", "title": "复制" },
      { "command": "uacsSolutionExplorer.paste", "title": "粘贴" },
      { "command": "uacsSolutionExplorer.copyPath", "title": "复制路径" },
      { "command": "uacsSolutionExplorer.copyRelativePath", "title": "复制相对路径" },
      { "command": "uacsSolutionExplorer.rename", "title": "重命名..." },
      { "command": "uacsSolutionExplorer.delete", "title": "删除" }
    ],
    "configuration": {
      "title": "UACS VS Solution Explorer",
      "properties": {
        "uacsSolutionExplorer.solutionPath": {
          "type": "string",
          "default": "Source/New_Server/UACS_GG5.sln",
          "description": "相对于工作区根目录的 .sln 路径。"
        },
        "uacsSolutionExplorer.autoFind": {
          "type": "boolean",
          "default": true,
          "description": "找不到指定解决方案时，自动搜索工作区中的第一个 .sln。"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "uacsSolutionExplorer.refresh",
          "when": "view == uacs-solution-tree",
          "group": "navigation"
        },
        {
          "command": "uacsSolutionExplorer.selectSolution",
          "when": "view == uacs-solution-tree",
          "group": "navigation"
        },
        {
          "command": "uacsSolutionExplorer.createFile",
          "when": "view == uacs-solution-tree",
          "group": "navigation@2"
        },
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project)",
          "group": "1_create@3"
        },
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == filter)",
          "group": "1_create@3"
        },
        {
          "command": "uacsSolutionExplorer.newFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "1_create@1"
        },
        {
          "command": "uacsSolutionExplorer.newFolder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "1_create@2"
        },
        {
          "command": "uacsSolutionExplorer.revealInFinder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "2_open@1"
        },
        {
          "command": "uacsSolutionExplorer.openInTerminal",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "2_open@2"
        },
        {
          "command": "uacsSolutionExplorer.addDirectoryToChat",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "3_chat@1"
        },
        {
          "command": "uacsSolutionExplorer.addDirectoryToNewChat",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "3_chat@2"
        },
        {
          "command": "uacsSolutionExplorer.findInFolder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "4_search@1"
        },
        {
          "command": "uacsSolutionExplorer.cut",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "5_edit@1"
        },
        {
          "command": "uacsSolutionExplorer.copy",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "5_edit@2"
        },
        {
          "command": "uacsSolutionExplorer.paste",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "enablement": "uacsSolutionExplorer.canPaste",
          "group": "5_edit@3"
        },
        {
          "command": "uacsSolutionExplorer.copyPath",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "6_path@1"
        },
        {
          "command": "uacsSolutionExplorer.copyRelativePath",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "6_path@2"
        },
        {
          "command": "uacsSolutionExplorer.rename",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "7_file@1"
        },
        {
          "command": "uacsSolutionExplorer.delete",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "7_file@2"
        }
      ]
    }
  },
  "keybindings": [
    { "command": "uacsSolutionExplorer.cut", "key": "cmd+x", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.copy", "key": "cmd+c", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.paste", "key": "cmd+v", "when": "focusedView == uacs-solution-tree && (viewItem == project || viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.rename", "key": "f2", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.delete", "key": "cmd+backspace", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" }
  ],
  "scripts": { "test": "node test/model.test.js" }
}
