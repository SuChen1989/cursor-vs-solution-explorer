{
  "name": "uacs-vs-solution-explorer",
  "displayName": "UACS VS Solution Explorer",
  "description": "A lightweight Visual Studio-style explorer for .sln, .vcxproj and .vcxproj.filters.",
  "version": "0.1.0",
  "publisher": "uacs-local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "workspaceContains:**/*.sln"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uacs-vs-solution-explorer",
          "title": "VS解决方案",
          "icon": "$(symbol-folder)"
        }
      ]
    },
    "views": {
      "uacs-vs-solution-explorer": [
        {
          "id": "uacs-solution-tree",
          "name": "解决方案资源管理器",
          "contextualTitle": "UACS VS Solution Explorer"
        },
        {
          "id": "uacs-diagnostics-tree",
          "name": "错误与警告",
          "contextualTitle": "UACS Diagnostics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "uacs-solution-tree",
        "contents": "尚未加载解决方案。 [选择解决方案](command:uacsSolutionExplorer.selectSolution) 或 [刷新](command:uacsSolutionExplorer.refresh)。"
      },
      {
        "view": "uacs-diagnostics-tree",
        "contents": "当前解决方案目录没有错误或警告。"
      }
    ],
    "commands": [
      { "command": "uacsSolutionExplorer.openSolution", "title": "UACS: 打开解决方案", "icon": "$(folder-opened)" },
      { "command": "uacsSolutionExplorer.refresh", "title": "UACS: 刷新解决方案树", "icon": "$(refresh)" },
      { "command": "uacsSolutionExplorer.selectSolution", "title": "UACS: 选择解决方案文件", "icon": "$(list-tree)" },
      { "command": "uacsSolutionExplorer.search", "title": "搜索解决方案文件...", "icon": "$(search)" },
      { "command": "uacsSolutionExplorer.revealActiveFile", "title": "定位当前文件", "icon": "$(locate)" },
      { "command": "uacsSolutionExplorer.build", "title": "构建项目", "icon": "$(run-all)" },
      { "command": "uacsSolutionExplorer.clean", "title": "清理项目", "icon": "$(clear-all)" },
      { "command": "uacsSolutionExplorer.setStartupProject", "title": "设置启动项目", "icon": "$(star-full)" },
      { "command": "uacsSolutionExplorer.refreshDiagnostics", "title": "刷新错误与警告", "icon": "$(refresh)" },
      { "command": "uacsSolutionExplorer.createFile", "title": "UACS: 新建代码文件", "icon": "$(new-file)" },
      { "command": "uacsSolutionExplorer.addExistingFile", "title": "导入现有代码文件...", "icon": "$(file-add)" },
      { "command": "uacsSolutionExplorer.newFile", "title": "新建文件...", "icon": "$(new-file)" },
      { "command": "uacsSolutionExplorer.newFolder", "title": "新建文件夹...", "icon": "$(new-folder)" },
      { "command": "uacsSolutionExplorer.revealInFinder", "title": "Reveal in Finder", "icon": "$(folder-opened)" },
      { "command": "uacsSolutionExplorer.openInTerminal", "title": "在集成终端中打开", "icon": "$(terminal)" },
      { "command": "uacsSolutionExplorer.addDirectoryToChat", "title": "Add Directory to Cursor Chat", "icon": "$(comment-discussion)" },
      { "command": "uacsSolutionExplorer.addDirectoryToNewChat", "title": "Add Directory to New Cursor Chat", "icon": "$(sparkle)" },
      { "command": "uacsSolutionExplorer.findInFolder", "title": "在文件夹中查找...", "icon": "$(search)" },
      { "command": "uacsSolutionExplorer.cut", "title": "剪切", "icon": "$(cut)" },
      { "command": "uacsSolutionExplorer.copy", "title": "复制", "icon": "$(copy)" },
      { "command": "uacsSolutionExplorer.paste", "title": "粘贴", "icon": "$(clippy)" },
      { "command": "uacsSolutionExplorer.copyPath", "title": "复制路径", "icon": "$(link)" },
      { "command": "uacsSolutionExplorer.copyRelativePath", "title": "复制相对路径", "icon": "$(go-to-file)" },
      { "command": "uacsSolutionExplorer.rename", "title": "重命名...", "icon": "$(edit)" },
      { "command": "uacsSolutionExplorer.delete", "title": "删除", "icon": "$(trash)" }
    ],
    "configuration": {
      "title": "UACS VS Solution Explorer",
      "properties": {
        "uacsSolutionExplorer.solutionPath": {
          "type": "string",
          "default": "Source/New_Server/UACS_GG5.sln",
          "description": "相对于工作区根目录的 .sln 路径。"
        },
        "uacsSolutionExplorer.autoFind": {
          "type": "boolean",
          "default": true,
          "description": "找不到指定解决方案时，自动搜索工作区中的第一个 .sln。"
        },
        "uacsSolutionExplorer.autoRevealActiveFile": {
          "type": "boolean",
          "default": true,
          "description": "打开代码文件时，自动在解决方案树中定位并选中它。"
        },
        "uacsSolutionExplorer.startupProject": {
          "type": "string",
          "default": "",
          "description": "启动项目名称，使用“设置启动项目”命令修改。"
        },
        "uacsSolutionExplorer.buildCommand": {
          "type": "string",
          "default": "",
          "description": "构建命令。支持 ${solution}、${project}、${projectName} 占位符。"
        },
        "uacsSolutionExplorer.cleanCommand": {
          "type": "string",
          "default": "",
          "description": "清理命令。支持 ${solution}、${project}、${projectName} 占位符。"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "uacsSolutionExplorer.refresh",
          "when": "view == uacs-solution-tree",
          "group": "navigation"
        },
        {
          "command": "uacsSolutionExplorer.selectSolution",
          "when": "view == uacs-solution-tree",
          "group": "navigation"
        },
        {
          "command": "uacsSolutionExplorer.newFile",
          "when": "view == uacs-solution-tree",
          "group": "navigation@2"
        },
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree",
          "group": "navigation@3"
        },
        {
          "command": "uacsSolutionExplorer.search",
          "when": "view == uacs-solution-tree",
          "group": "navigation@4"
        },
        {
          "command": "uacsSolutionExplorer.revealActiveFile",
          "when": "view == uacs-solution-tree",
          "group": "navigation@5"
        },
        {
          "command": "uacsSolutionExplorer.setStartupProject",
          "when": "view == uacs-solution-tree",
          "group": "navigation@6"
        },
        {
          "command": "uacsSolutionExplorer.build",
          "when": "view == uacs-solution-tree",
          "group": "navigation@7"
        },
        {
          "command": "uacsSolutionExplorer.clean",
          "when": "view == uacs-solution-tree",
          "group": "navigation@8"
        },
        {
          "command": "uacsSolutionExplorer.refreshDiagnostics",
          "when": "view == uacs-diagnostics-tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project)",
          "group": "1_create@3"
        },
        {
          "command": "uacsSolutionExplorer.addExistingFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == filter)",
          "group": "1_create@3"
        },
        {
          "command": "uacsSolutionExplorer.newFile",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "1_create@1"
        },
        {
          "command": "uacsSolutionExplorer.newFolder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "1_create@2"
        },
        {
          "command": "uacsSolutionExplorer.revealInFinder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "2_open@1"
        },
        {
          "command": "uacsSolutionExplorer.openInTerminal",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "2_open@2"
        },
        {
          "command": "uacsSolutionExplorer.addDirectoryToChat",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "3_chat@1"
        },
        {
          "command": "uacsSolutionExplorer.addDirectoryToNewChat",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "3_chat@2"
        },
        {
          "command": "uacsSolutionExplorer.findInFolder",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter)",
          "group": "4_search@1"
        },
        {
          "command": "uacsSolutionExplorer.cut",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "5_edit@1"
        },
        {
          "command": "uacsSolutionExplorer.copy",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "5_edit@2"
        },
        {
          "command": "uacsSolutionExplorer.paste",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "enablement": "uacsSolutionExplorer.canPaste",
          "group": "5_edit@3"
        },
        {
          "command": "uacsSolutionExplorer.copyPath",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "6_path@1"
        },
        {
          "command": "uacsSolutionExplorer.copyRelativePath",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project || viewItem == filter || viewItem == file)",
          "group": "6_path@2"
        },
        {
          "command": "uacsSolutionExplorer.rename",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "7_file@1"
        },
        {
          "command": "uacsSolutionExplorer.delete",
          "when": "view == uacs-solution-tree && (viewItem == filter || viewItem == file)",
          "group": "7_file@2"
        },
        {
          "command": "uacsSolutionExplorer.setStartupProject",
          "when": "view == uacs-solution-tree && viewItem == project",
          "group": "8_project@1"
        },
        {
          "command": "uacsSolutionExplorer.build",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project)",
          "group": "8_project@2"
        },
        {
          "command": "uacsSolutionExplorer.clean",
          "when": "view == uacs-solution-tree && (viewItem == solution || viewItem == solutionFolder || viewItem == project)",
          "group": "8_project@3"
        }
      ]
    }
  },
  "keybindings": [
    { "command": "uacsSolutionExplorer.cut", "key": "cmd+x", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.copy", "key": "cmd+c", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.paste", "key": "cmd+v", "when": "focusedView == uacs-solution-tree && (viewItem == project || viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.rename", "key": "f2", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" },
    { "command": "uacsSolutionExplorer.delete", "key": "cmd+backspace", "when": "focusedView == uacs-solution-tree && (viewItem == filter || viewItem == file)" }
  ],
  "scripts": { "test": "node test/model.test.js" }
}
